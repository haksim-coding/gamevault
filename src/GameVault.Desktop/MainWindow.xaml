<Window x:Class="GameVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameVault.Localization"
        Title="GameVault"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource SurfaceLightBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A2448" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#252A36"
                BorderThickness="0,0,1,0">
            <Grid Margin="22,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="G" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GAMEVAULT" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{loc:Loc PersonalLibrary}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="9" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{loc:Loc Menu}" Margin="10,0,0,10"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <Button Command="{Binding ShowHomeCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="20" Width="32" />
                            <TextBlock Text="{loc:Loc Home}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowLibraryCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" FontSize="19" Width="32" />
                            <TextBlock Text="{loc:Loc Library}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowCatalogCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="C" FontSize="16" FontWeight="Bold" Width="32" />
                            <TextBlock Text="{loc:Loc Catalog}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowProfileCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="16" Width="32" />
                            <TextBlock Text="{loc:Loc Profile}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowFriendsCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" Width="32" />
                            <TextBlock Text="{loc:Loc Friends}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowAuthCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="@" FontSize="16" FontWeight="Bold" Width="32" />
                            <TextBlock Text="{loc:Loc Account}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowReportsCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="18" Width="32" />
                            <TextBlock Text="{loc:Loc Reports}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="S" FontSize="16" FontWeight="Bold" Width="32" />
                            <TextBlock Text="{loc:Loc Settings}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Padding="13"
                        Background="{StaticResource SurfaceLightBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OnlineAccount}" Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding AccountName}" Margin="0,4,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AccountStatus}" Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>

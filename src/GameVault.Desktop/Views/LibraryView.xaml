<UserControl x:Class="GameVault.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameVault.Localization">
    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#242A38" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30384A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252B38" />
                                <Setter Property="Foreground" Value="#AAB1C0" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="#252B38" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                            <Rectangle x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#2A3040" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GenreComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#292442" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GenreComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GenreComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BaseBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="12,0,4,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectedItem,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{StaticResource MutedTextBrush}"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BaseBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="BaseBorder"
                                                        Property="Background"
                                                        Value="{StaticResource SurfaceLightBrush}" />
                                                <Setter TargetName="BaseBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,5,0,0"
                                        Padding="4"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="#303647"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,35,42,40">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Library}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14">
                        <Run Text="{Binding GameCount, Mode=OneWay}" />
                        <Run Text="{loc:Loc GamesShown}" />
                    </TextBlock>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{loc:Loc AddGame}"
                        Command="{Binding AddGameCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </Grid>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Loc SearchByTitle}"
                         Style="{StaticResource ToolbarTextBoxStyle}" />
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Genres}"
                          SelectedItem="{Binding SelectedGenre}"
                          Height="42"
                          Style="{StaticResource GenreComboBoxStyle}" />
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding SortOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedSort}"
                          ToolTip="{loc:Loc SortBy}"
                          Height="42"
                          Style="{StaticResource GenreComboBoxStyle}" />
            </Grid>

            <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding GamesView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,14" Padding="18"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="86"
                                        Height="100"
                                        HorizontalAlignment="Left"
                                        CornerRadius="12"
                                        ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7C5CFC" Offset="0" />
                                            <GradientStop Color="#2C3152" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="GV"
                                                       Foreground="#AFFFFFFF"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc NoCover}"
                                                       Margin="0,3,0,0"
                                                       Foreground="#8FFFFFFF"
                                                       FontSize="8"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Image Source="{Binding CoverImagePath}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="13">
                                        <Run Text="{Binding Genre}" />
                                        <Run Text="  •  " />
                                        <Run Text="{Binding ReleaseYear}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding Developer}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                    <StackPanel Margin="0,9,0,0"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding SourceLabel, Converter={StaticResource LocalizedValueConverter}}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  "
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding InstallStatusLabel, Converter={StaticResource LocalizedValueConverter}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" />
                                        <TextBlock Text="  ·  "
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Visibility="{Binding IsDownloadInProgress,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding DownloadSpeedLabel}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Visibility="{Binding IsDownloadInProgress,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <ProgressBar Margin="0,7,40,0"
                                                 Height="6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding DownloadProgress}"
                                                 Style="{StaticResource DownloadProgressBarStyle}"
                                                 Visibility="{Binding IsDownloadInProgress,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PlayTimeMinutes,
                                                Converter={StaticResource PlayTimeConverter}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Right" />
                                    <StackPanel Margin="0,12,0,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="{loc:Loc Play}"
                                                Command="{Binding DataContext.PlayGameCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanPlay}"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Foreground="White"
                                                Style="{StaticResource CardButtonStyle}" />
                                        <Button Content="{loc:Loc Edit}"
                                                Command="{Binding DataContext.EditGameCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CardButtonStyle}" />
                                        <Button Content="{Binding DeleteOrCancelButtonText, Converter={StaticResource LocalizedValueConverter}}"
                                                Command="{Binding DataContext.DeleteGameCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CardButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

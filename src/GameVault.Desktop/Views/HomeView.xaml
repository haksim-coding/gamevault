<UserControl x:Class="GameVault.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameVault.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,35,42,40">
            <Grid>
                <StackPanel>
            <TextBlock Text="{loc:Loc WelcomeBack}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc GamesReady}" Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="13,8" Background="{StaticResource SurfaceBrush}" CornerRadius="18">
                <TextBlock Text="{loc:Loc LocalMode}" Foreground="#71D9A0"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Border Height="270" Margin="0,32,0,25" CornerRadius="18" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#382B73" Offset="0" />
                        <GradientStop Color="#151B35" Offset="0.58" />
                        <GradientStop Color="#12141B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc FeaturedFromLibrary}"
                                   Foreground="#B9ACFF" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding FeaturedGame.Title}" Margin="0,10,0,0"
                                   FontSize="38" FontWeight="Bold" />
                        <TextBlock Margin="0,8,0,0" Foreground="#C3C6D1" FontSize="14">
                            <Run Text="{Binding FeaturedGame.Genre}" />
                            <Run Text="  •  " />
                            <Run Text="{Binding FeaturedGame.ReleaseYear}" />
                        </TextBlock>
                        <Border Margin="0,22,0,0" Padding="16,9" HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryBrush}" CornerRadius="8">
                        <TextBlock Text="{loc:Loc InYourLibrary}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Width="190" Height="190" CornerRadius="95"
                            Background="#1AFFFFFF" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="GV" Foreground="#70FFFFFF" FontSize="58"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="22"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc GamesUpper}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding GameCount}" Margin="0,7,0,0"
                                   FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc InYourCollection}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="22"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc PlayTimeUpper}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Margin="0,7,0,0" FontSize="28" FontWeight="SemiBold">
                            <Run Text="{Binding TotalHours, Mode=OneWay}" />
                            <Run Text=" h" />
                        </TextBlock>
                        <TextBlock Text="{loc:Loc AcrossAllGames}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,30,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc RecentActivity}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc RecentActivityDescription}"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="12,7"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16">
                <TextBlock Text="{loc:Loc LastEight}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding RecentActivities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <TextBlock Text="•"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="13,0,18,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Action}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,4,0,0"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding TimestampText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <TextBlock Text="{loc:Loc NoActivity}"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecentActivity}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="GameVault.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameVault.Localization">
    <UserControl.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondarySettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#292442" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="42" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource SettingsComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BaseBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="12,0,4,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectedItem.DisplayName,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{StaticResource MutedTextBrush}"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BaseBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="BaseBorder"
                                                        Property="Background"
                                                        Value="{StaticResource SurfaceLightBrush}" />
                                                <Setter TargetName="BaseBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,5,0,0"
                                        Padding="4"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="#303647"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Height" Value="42" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="DiagnosticsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,5,18,5" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="DiagnosticsValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,35,42,40">
            <TextBlock Text="{loc:Loc Settings}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc SettingsDescription}"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14" />

            <Border Margin="0,28,0,0"
                    Padding="24"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ApplicationUpper}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc AccentColor}" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding AccentColors}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedAccentColor}"
                                      Style="{StaticResource SettingsComboBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Language}" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedLanguage}"
                                      Style="{StaticResource SettingsComboBoxStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,15,0,15"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap">
                        <Run Text="{loc:Loc IniLocation}" />
                        <Run Text="{Binding SettingsPath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{loc:Loc DownloadsUpper}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc DefaultInstallFolder}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding DefaultInstallFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc DownloadSpeedLimit}" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding DownloadSpeedLimits}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDownloadSpeedLimit}"
                                      Style="{StaticResource SettingsComboBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc ServerDiscoveryUpper}"
                               Margin="0,24,0,0"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="{loc:Loc FindGameVaultServer}"
                                HorizontalAlignment="Left"
                                Command="{Binding FindGameVaultServerCommand}"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <TextBlock Text="{Binding ServerDiscoveryStatus}"
                                   Margin="4,10,0,10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </WrapPanel>
                    <Button Content="{loc:Loc SaveSettings}"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource SettingsButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0"
                    Padding="24"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc NetworkDiagnostics}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="{loc:Loc NetworkDiagnosticsDescription}"
                               Margin="0,8,0,14"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{loc:Loc DiscoveryStatus}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DiagnosticsDiscoveryStatus}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc LanServerIp}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagnosticsLanServerIp}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc ServerName}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiagnosticsServerName}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="3" Text="{loc:Loc ServerVersion}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagnosticsServerVersion}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="4" Text="{loc:Loc ServerStatus}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiagnosticsServerStatus}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="5" Text="{loc:Loc ApiBaseUrl}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DiagnosticsApiBaseUrl}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="6" Text="{loc:Loc FilesBaseUrl}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DiagnosticsFilesBaseUrl}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="7" Text="{loc:Loc ManifestUrl}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DiagnosticsManifestUrl}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="8" Text="{loc:Loc PublicClientIp}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DiagnosticsPublicClientIp}" Style="{StaticResource DiagnosticsValueStyle}" />
                        <TextBlock Grid.Row="9" Text="{loc:Loc LastChecked}" Style="{StaticResource DiagnosticsLabelStyle}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DiagnosticsLastChecked}" Style="{StaticResource DiagnosticsValueStyle}" />
                    </Grid>

                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding RunNetworkDiagnosticsCommand}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsButtonStyle}">
                                <Setter Property="Content" Value="{loc:Loc RunNetworkDiagnostics}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiagnosticsRunning}" Value="True">
                                        <Setter Property="Content" Value="{loc:Loc RunningDiagnostics}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,6,0,0"
                               Foreground="#71D9A0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Loc BackupTransfer}"
                       Margin="0,28,0,5"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc BackupTransferDescription}"
                       Foreground="{StaticResource MutedTextBrush}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="22"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc GameLibrary}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc GameLibraryTransferDescription}"
                                   Margin="0,8,0,18"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="{loc:Loc ExportLibrary}"
                                HorizontalAlignment="Left"
                                Command="{Binding ExportJsonCommand}"
                                Style="{StaticResource SettingsButtonStyle}"
                                ToolTip="{loc:Loc FormatJson}" />
                        <Button Content="{loc:Loc ImportLibrary}"
                                HorizontalAlignment="Left"
                                Command="{Binding ImportJsonCommand}"
                                Style="{StaticResource SecondarySettingsButtonStyle}"
                                ToolTip="{loc:Loc FormatJson}" />
                        <TextBlock Text="{loc:Loc FormatJson}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="22"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc SecureBackup}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc SecureBackupDescription}"
                                   Margin="0,8,0,18"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="{loc:Loc CreateSecureBackup}"
                                HorizontalAlignment="Left"
                                Command="{Binding CreateSecureBackupCommand}"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button Content="{loc:Loc CheckBackupFile}"
                                HorizontalAlignment="Left"
                                Command="{Binding CheckSecureBackupCommand}"
                                Style="{StaticResource SecondarySettingsButtonStyle}" />
                        <Button Content="{loc:Loc RestoreSecureBackup}"
                                HorizontalAlignment="Left"
                                Command="{Binding RestoreSecureBackupCommand}"
                                Style="{StaticResource SecondarySettingsButtonStyle}" />
                        <TextBlock Text="{loc:Loc FormatGvb}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="22"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc ActivityHistory}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc ActivityHistoryDescription}"
                                   Margin="0,8,0,18"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="{loc:Loc ExportActivityHistory}"
                                HorizontalAlignment="Left"
                                Command="{Binding ExportXmlCommand}"
                                Style="{StaticResource SettingsButtonStyle}"
                                ToolTip="{loc:Loc FormatXml}" />
                        <Button Content="{loc:Loc OpenActivityHistory}"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenActivityHistoryCommand}"
                                Style="{StaticResource SecondarySettingsButtonStyle}"
                                ToolTip="{loc:Loc FormatXml}" />
                        <TextBlock Text="{loc:Loc FormatXml}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="22"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc ActivityArchive}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc ActivityArchiveDescription}"
                                   Margin="0,8,0,18"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="{loc:Loc CreateActivityArchive}"
                                HorizontalAlignment="Left"
                                Command="{Binding ExportBinaryActivityCommand}"
                                Style="{StaticResource SettingsButtonStyle}"
                                ToolTip="{loc:Loc FormatActivityArchive}" />
                        <Button Content="{loc:Loc OpenActivityArchive}"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenActivityArchiveCommand}"
                                Style="{StaticResource SecondarySettingsButtonStyle}"
                                ToolTip="{loc:Loc ArchiveSummaryTooltip}" />
                        <TextBlock Text="{loc:Loc FormatActivityArchive}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,18,0,0"
                    Padding="18"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#71D9A0"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

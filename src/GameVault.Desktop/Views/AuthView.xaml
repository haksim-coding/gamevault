<UserControl x:Class="GameVault.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AuthInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AuthTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,6,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceLightBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,35">
        <Border Width="520"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16">
            <Grid>
                <StackPanel Visibility="{Binding LoginFormVisibility}">
                    <TextBlock Text="GameVault Account" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Connect your account for Friends and public statistics."
                               Margin="0,7,0,22"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <TabControl Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                        <TabItem Header="Login"
                                 Style="{StaticResource AuthTabItemStyle}">
                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="Username" Margin="0,0,0,7" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AuthInputStyle}" />

                                <TextBlock Text="Password" Margin="0,17,0,7" />
                                <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource SurfaceLightBrush}"
                                             BorderBrush="#303647"
                                             Padding="12,10" />

                                <Button Content="Login"
                                        Margin="0,22,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding LoginCommand}"
                                        Style="{StaticResource AuthButtonStyle}" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Register"
                                 Style="{StaticResource AuthTabItemStyle}">
                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="Username" Margin="0,0,0,7" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AuthInputStyle}" />

                                <TextBlock Text="Password" Margin="0,17,0,7" />
                                <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource SurfaceLightBrush}"
                                             BorderBrush="#303647"
                                             Padding="12,10" />

                                <TextBlock Text="Display name" Margin="0,17,0,7" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AuthInputStyle}" />

                                <Button Content="Create Account"
                                        Margin="0,22,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RegisterCommand}"
                                        Style="{StaticResource AuthButtonStyle}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,18,0,0"
                               Foreground="#F0B56A"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Visibility="{Binding LoggedInVisibility}">
                    <TextBlock Text="GameVault Account" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="You are connected to the GameVault server."
                               Margin="0,7,0,24"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding SessionUsername}"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,22" Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="Role: " />
                        <Run Text="{Binding SessionRole, Mode=OneWay}" />
                    </TextBlock>
                    <Button Content="Logout"
                            HorizontalAlignment="Left"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource AuthButtonStyle}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,18,0,0"
                               Foreground="#71D9A0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

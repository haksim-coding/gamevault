<Window x:Class="GameVault.Views.AddEditGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameVault.Localization"
        Title="{loc:Loc AddGame}"
        Width="540"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Text="{loc:Loc AddGame}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc GameDialogDescription}"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,25,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                <TextBlock Text="{loc:Loc Title}" Margin="0,0,0,6" />
                <TextBox x:Name="TitleTextBox" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc Genre}" Margin="0,0,0,6" />
                <TextBox x:Name="GenreTextBox" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc ReleaseYear}" Margin="0,0,0,6" />
                <TextBox x:Name="ReleaseYearTextBox" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc Developer}" Margin="0,0,0,6" />
                <TextBox x:Name="DeveloperTextBox" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc ExecutablePath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutablePathTextBox" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc Browse}"
                            Style="{StaticResource BrowseButtonStyle}"
                            Click="BrowseExecutableButton_Click" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc InstallPath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathTextBox" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc Browse}"
                            Style="{StaticResource BrowseButtonStyle}"
                            Click="BrowseInstallPathButton_Click" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc CoverImage}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CoverImagePathTextBox" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc Browse}"
                            Style="{StaticResource BrowseButtonStyle}"
                            Click="BrowseCoverButton_Click" />
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Cancel}"
                    Background="{StaticResource SurfaceLightBrush}"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="CancelButton_Click" />
            <Button Content="{loc:Loc Save}"
                    Background="{DynamicResource PrimaryBrush}"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

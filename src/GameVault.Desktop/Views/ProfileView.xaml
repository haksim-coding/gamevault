<UserControl x:Class="GameVault.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProfileTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="BorderBrush" Value="#303647" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="11,9" />
        </Style>
        <Style x:Key="ProfileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,35,42,40">
            <TextBlock Text="Profile" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Your local GameVault identity and progress."
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14" />

            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="22"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="150"
                                Height="150"
                                CornerRadius="75"
                                ClipToBounds="True"
                                Background="{StaticResource SurfaceLightBrush}">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="GV"
                                               FontSize="38"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="AVATAR"
                                               Margin="0,3,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding DisplayName}"
                                   Margin="0,18,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,5,0,18"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center">
                            <Run Text="@" />
                            <Run Text="{Binding Username}" />
                        </TextBlock>
                        <Button Content="Upload Avatar"
                                Command="{Binding UploadAvatarCommand}"
                                Style="{StaticResource ProfileButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="24"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Username" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Display name" Margin="0,0,0,7" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
                            <TextBlock Text="Favorite game" Margin="0,0,0,7" />
                            <TextBox Text="{Binding FavoriteGame, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0">
                            <TextBlock Text="Bio" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                     Height="92"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource ProfileTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Margin="0,20,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,0,16,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="Save Profile"
                                    Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource ProfileButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="Achievements"
                       Margin="0,34,0,5"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Milestones unlocked by your GameVault activity."
                       Foreground="{StaticResource MutedTextBrush}" />

            <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Achievements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="AchievementCard"
                                Margin="0,0,0,12"
                                Padding="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="#292E3B"
                                BorderThickness="1"
                                CornerRadius="12"
                                Opacity="0.58">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <TextBlock x:Name="AchievementIcon"
                                               Text="◇"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock x:Name="StatusText"
                                               Text="{Binding StatusText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DateText}"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                <Setter TargetName="AchievementCard" Property="Opacity" Value="1" />
                                <Setter TargetName="AchievementCard"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="AchievementIcon" Property="Text" Value="◆" />
                                <Setter TargetName="AchievementIcon"
                                        Property="Foreground"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="StatusText"
                                        Property="Foreground"
                                        Value="#71D9A0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

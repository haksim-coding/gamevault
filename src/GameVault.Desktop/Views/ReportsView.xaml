<UserControl x:Class="GameVault.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameVault.Localization">
    <UserControl.Resources>
        <Style x:Key="StatisticCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="GenerateReportButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,35,42,40">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Reports}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc ReportsDescription}"
                               Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{loc:Loc GeneratePdfReport}"
                        Command="{Binding GeneratePdfCommand}"
                        Style="{StaticResource GenerateReportButtonStyle}" />
            </Grid>

            <UniformGrid Margin="0,30,0,0" Columns="3">
                <Border Margin="0,0,12,12" Style="{StaticResource StatisticCardStyle}">
                    <StackPanel>
                            <TextBlock Text="{loc:Loc TotalGames}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalGames}"
                                   Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,12" Style="{StaticResource StatisticCardStyle}">
                    <StackPanel>
                            <TextBlock Text="{loc:Loc TotalPlayTime}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalPlayTime}"
                                   Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,12" Style="{StaticResource StatisticCardStyle}">
                    <StackPanel>
                            <TextBlock Text="{loc:Loc TopGenre}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding MostCommonGenre}"
                                   Margin="0,8,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatisticCardStyle}">
                    <StackPanel>
                            <TextBlock Text="{loc:Loc NewestAddedGame}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding NewestAddedGame}"
                                   Margin="0,8,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatisticCardStyle}">
                    <StackPanel>
                            <TextBlock Text="{loc:Loc UnlockedAchievements}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding UnlockedAchievements}"
                                   Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatisticCardStyle}">
                    <StackPanel>
                            <TextBlock Text="{loc:Loc ReportLocation}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="Documents/GameVault/Reports"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Margin="0,28,0,0"
                    Padding="24"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14">
                <StackPanel>
                <TextBlock Text="{loc:Loc PdfContent}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                <TextBlock Text="{loc:Loc PdfContentDescription}"
                               Margin="0,9,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,16,0,0"
                               Foreground="#71D9A0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

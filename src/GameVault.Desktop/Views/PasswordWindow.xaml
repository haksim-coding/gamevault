<Window x:Class="GameVault.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameVault.Localization"
        Title="{loc:Loc Password}"
        Width="420"
        Height="235"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   Text="{loc:Loc EnterPassword}"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="{loc:Loc PasswordDescription}"
                   Margin="0,6,0,16"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordInput"
                     Grid.Row="2"
                     Padding="10,8"
                     Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource SurfaceLightBrush}"
                     BorderBrush="#303647" />
        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{loc:Loc Cancel}"
                    Padding="16,9"
                    Margin="0,0,8,0"
                    Foreground="{StaticResource TextBrush}"
                    Background="{StaticResource SurfaceLightBrush}"
                    BorderThickness="0"
                    Click="CancelButton_Click" />
            <Button Content="{loc:Loc Continue}"
                    Padding="16,9"
                    Foreground="White"
                    Background="{DynamicResource PrimaryBrush}"
                    BorderThickness="0"
                    Click="ContinueButton_Click" />
        </StackPanel>
    </Grid>
</Window>

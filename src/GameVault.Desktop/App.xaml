<Application x:Class="GameVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GameVault.Converters"
             xmlns:viewModels="clr-namespace:GameVault.ViewModels"
             xmlns:views="clr-namespace:GameVault.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:PlayTimeConverter x:Key="PlayTimeConverter" />
        <converters:LocalizedValueConverter x:Key="LocalizedValueConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CatalogViewModel}">
            <views:CatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AuthViewModel}">
            <views:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:FriendsViewModel}">
            <views:FriendsView />
        </DataTemplate>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D12" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#13161E" />
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="#1A1E28" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#7C5CFC" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9298A7" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GameVault</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
    <ProjectReference Include="..\GameVault.Data\GameVault.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="public_key.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyBackupTool" AfterTargets="Build">
    <MSBuild Projects="..\GameVault.BackupTool\GameVault.BackupTool.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <BackupToolFiles Include="..\GameVault.BackupTool\bin\$(Configuration)\net10.0\GameVault.BackupTool.*" />
      <BackupToolFiles Include="..\GameVault.BackupTool\bin\$(Configuration)\net10.0\GameVault.Core.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BackupToolFiles)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
  </ItemGroup>

</Project>
